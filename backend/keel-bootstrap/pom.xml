<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.keel</groupId>
        <artifactId>keel</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>keel-bootstrap</artifactId>
    <name>keel-bootstrap</name>
    <description>启动、装配与全局配置</description>

    <dependencies>
        <dependency>
            <groupId>io.github.keel</groupId>
            <artifactId>keel-common-web</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.keel</groupId>
            <artifactId>keel-common-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.keel</groupId>
            <artifactId>keel-common-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.keel</groupId>
            <artifactId>keel-iam</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.keel</groupId>
            <artifactId>keel-system</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.keel</groupId>
            <artifactId>keel-audit</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.keel</groupId>
            <artifactId>keel-common-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
